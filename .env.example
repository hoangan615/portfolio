# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME="Portfolio Platform"
APP_VERSION=0.1.0
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ALLOWED_HOSTS=["http://localhost:3000","http://localhost:80"]
API_PREFIX=/api/v1

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/portfolio_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── OAuth ─────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
OAUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# ── Storage (MinIO / S3-compatible) ───────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=portfolio-media
MINIO_SECURE=false
# Also available as S3_* aliases for boto3 compatibility
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=portfolio-media
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000/portfolio-media

# ── Email (Mailhog for local dev) ─────────────────────────────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@portfolio.local
SMTP_TLS=false

# ── App URLs ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Owner seed account (created on first start) ───────────────────────────────
OWNER_EMAIL=owner@portfolio.local
OWNER_USERNAME=owner
OWNER_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
